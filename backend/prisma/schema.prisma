// MapMyLAN v2 schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        String   @default("admin")
  createdAt   DateTime @default(now())
  lastLogin   DateTime?
  // Second facteur : secret partagé avec l'application d'authentification.
  totpSecret  String?
  totpEnabled Boolean  @default(false)
  // Force le changement à la prochaine connexion : mot de passe temporaire,
  // remise à zéro par un administrateur, ou compte fraîchement créé.
  mustChangePassword Boolean @default(false)
  // Incrémentée à chaque révocation : invalide tous les jetons déjà émis.
  tokenVersion Int       @default(0)
  // Verrouillage temporaire après une série d'échecs.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
}

// Demande de réinitialisation en cours. Deux facteurs indépendants sont exigés :
// le code de l'application et celui envoyé sur Telegram. Expire vite, essais
// plafonnés.
model PasswordReset {
  id            String   @id @default(cuid())
  userId        String
  telegramCode  String
  telegramSent  Boolean  @default(false)
  attempts      Int      @default(0)
  consumed      Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  @@index([userId])
}

model Device {
  id            String   @id @default(cuid())
  ip            String
  mac           String?  @unique
  hostname      String?
  customName    String?  // user-edited display name
  vendor        String?
  model         String?
  os            String?
  type          String   @default("unknown")  // router|switch|ap|firewall|server|laptop|phone|iot|unknown
  customType    String?  // user override
  vlan          Int?
  zone          String?  // user-defined area (Living, Office, etc.)
  tags          String[] @default([])
  notes         String?
  role          String?  // gateway|core|edge|client (auto-detected)

  status        String   @default("online")   // online|offline|suspect|quarantined|banned

  // ── 4-axis scoring ──
  trustScore    Int      @default(50)   // 0-100, higher = more trusted
  activityScore Int      @default(0)    // 0-100, higher = more suspicious activity
  vulnScore     Int      @default(0)    // 0-100, higher = more vulnerable
  dangerScore   Int      @default(0)    // 0-100, final fused score, higher = more dangerous
  scoreReasons  Json?    // breakdown of how the scores were computed

  // ── Protection ──
  whitelisted   Boolean  @default(false)  // never auto-banned
  isMainRouter  Boolean  @default(false)  // protected, never bannable

  // ── Map persistence ──
  posX          Float?
  posY          Float?
  pinned        Boolean  @default(false)

  firstSeen     DateTime @default(now())
  lastSeen      DateTime @default(now())
  metadata      Json?

  ports         Port[]
  cves          CveMatch[]
  history       DeviceHistory[]
  interfaces    Interface[]
  linksFrom     TopologyLink[] @relation("from")
  linksTo       TopologyLink[] @relation("to")

  @@index([ip])
  @@index([status])
  @@index([dangerScore])
}

// Network Interfaces (NICs). One device may have several (e.g. Wi-Fi + Ethernet).
// Each interface has its own MAC and may have its own position on the topology map,
// so the same physical device can be shown twice on the map with one link going
// to its LAN switch and another to its Wi-Fi AP.
model Interface {
  id        String   @id @default(cuid())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId  String
  mac       String?  @unique
  ip        String?
  type      String   @default("ethernet")  // ethernet|wifi|virtual|other
  label     String?  // user label, e.g. "eth0", "wlan0"
  posX      Float?
  posY      Float?
  isPrimary Boolean  @default(false)  // primary NIC mirrors Device.mac/ip
  createdAt DateTime @default(now())
  @@index([deviceId])
}

model Port {
  id         String   @id @default(cuid())
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId   String
  port       Int
  protocol   String
  state      String
  service    String?
  product    String?
  version    String?
  detectedAt DateTime @default(now())
  @@unique([deviceId, port, protocol])
}

model CveMatch {
  id          String   @id @default(cuid())
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId    String
  cveId       String
  cvss        Float
  severity    String
  description String
  service     String?
  detectedAt  DateTime @default(now())
}

model DeviceHistory {
  id        String   @id @default(cuid())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId  String
  event     String   // ip_change|first_seen|status_change|score_change|action_taken|note_added
  data      Json
  createdAt DateTime @default(now())
  @@index([deviceId, createdAt])
}

// User-editable & auto-discovered links
// Links can connect either two whole devices (legacy) or two specific interfaces.
// Interface-level links allow the same device to appear on the map with separate
// LAN and Wi-Fi nodes connected to different upstream gear.
model TopologyLink {
  id        String   @id @default(cuid())
  fromId    String
  from      Device   @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Device   @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  fromIfaceId String?
  toIfaceId   String?
  type      String   @default("ethernet")  // ethernet|wifi|vpn|trunk|wan|docker|sibling
  speed     String?
  vlan      String?
  manual    Boolean  @default(false)
  createdAt DateTime @default(now())
  @@unique([fromId, toId, fromIfaceId, toIfaceId])
}

model Zone {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#38bdf8")
  x         Float
  y         Float
  width     Float    @default(200)
  height    Float    @default(150)
  notes     String?
  createdAt DateTime @default(now())
}

model Vlan {
  id          Int      @id
  name        String
  subnet      String
  description String?
  color       String   @default("#38bdf8")
  isolated    Boolean  @default(false)
  createdAt   DateTime @default(now())

  /// Adresse que la passerelle porte sur ce VLAN, relevée sur l'équipement.
  /// Sert à écarter cette adresse quand on en réserve une : la donner à une
  /// machine coupe le réseau du segment entier.
  gateway     String?
  /// Identifiant du réseau chez le constructeur. Une réservation d'adresse
  /// doit dire de quel réseau l'adresse relève, pas seulement laquelle.
  networkId   String?
}

model SshDevice {
  id            String   @id @default(cuid())
  name          String
  host          String
  port          Int      @default(22)
  username      String
  passwordEnc   String?
  privateKeyEnc String?
  passphraseEnc String?
  // Identifiant de l'adaptateur : unifi, asus-merlin, openwrt, routeros,
  // pfsense, cisco-ios, zyxel, edgeos, generic.
  vendor        String   @default("generic")
  // Voie de pilotage : ssh pour la plupart, api pour UniFi.
  transport     String   @default("ssh")
  apiBaseUrl    String?
  site          String?
  verifyTls     Boolean  @default(false)
  isMainRouter  Boolean  @default(false)
  lastConnected DateTime?
  lastTestOk    Boolean?
  lastTestAt    DateTime?
  lastTestInfo  String?
  createdAt     DateTime @default(now())
}

model Alert {
  id           String   @id @default(cuid())
  severity     String
  source       String
  message      String
  deviceId     String?
  deviceIp     String?
  deviceMac    String?
  acknowledged Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())
  @@index([createdAt])
  @@index([severity])
}

model LogEntry {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model NotificationConfig {
  id          String   @id @default(cuid())
  channel     String   @unique
  enabled     Boolean  @default(false)
  configEnc   String?
  lastTested  DateTime?
  lastSuccess DateTime?
}

// User-defined bot commands. The user types /something in Telegram (or whatever
// channel later supports it) and the bot runs the configured action server-side.
// Examples:
//   { trigger: "/alert",   action: "lockdown",   confirm: true }
//   { trigger: "/status",  action: "status" }
//   { trigger: "/scan",    action: "scan_now" }
//   { trigger: "/reboot_router", action: "exec_ssh", params: { deviceId: "...", cmd: "reboot" }, confirm: true }
model BotCommand {
  id              String   @id @default(cuid())
  trigger         String   @unique  // e.g. "/alert" or "/lockdown"
  description     String?
  action          String   // see ACTIONS catalog in services/botCommands.ts
  params          Json?    // arbitrary action-specific parameters
  enabled         Boolean  @default(true)
  confirm         Boolean  @default(false)  // require Y/N reply before exec
  allowedChatIds  String[] @default([])     // empty = primary chatId only
  cooldownSec     Int      @default(0)
  lastFiredBy     String?
  lastFiredAt     DateTime?
  fireCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// User-defined "when X happens → do Y" rules.
// Each command has a trigger (one of ~50 events), one or more actions (notify
// channels and/or in-app actions), an optional cooldown, and an optional filter.
model NotificationCommand {
  id           String   @id @default(cuid())
  name         String
  enabled      Boolean  @default(true)
  trigger      String   // see TRIGGERS catalog in services/commands.ts
  filter       Json?    // optional filter, e.g. { minSeverity: "high", deviceType: "iot" }
  actions      Json     // array, e.g. [{ kind: "notify", channels: ["telegram", "email"] }, { kind: "log" }]
  template     String?  // optional message template with {{placeholders}}
  cooldownSec  Int      @default(0)
  lastFired    DateTime?
  fireCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([trigger, enabled])
}

model SecurityRule {
  id          String   @id @default(cuid())
  name        String
  enabled     Boolean  @default(true)
  trigger     String   // dangerScore|portScan|arpSpoof|cve|newDevice
  threshold   Float?
  action      String   // alert|quarantine|ban|disablePort
  exceptWhitelist Boolean @default(true)
  createdAt   DateTime @default(now())
}

model ScanRun {
  id         String   @id @default(cuid())
  type       String
  subnet     String
  status     String   @default("running")
  hostsFound Int      @default(0)
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  error      String?
}

model HostMetric {
  id          String   @id @default(cuid())
  cpuPct      Float
  memPct      Float
  memUsedMB   Int
  memTotalMB  Int
  diskPct     Float
  tempC       Float?
  loadAvg     Float
  netRxKBs    Float
  netTxKBs    Float
  uptimeSec   Int
  createdAt   DateTime @default(now())
  @@index([createdAt])
}

// Boîte mail configurée dans les réglages.
//
// Le mot de passe est chiffré au repos par services/crypto.ts, qui empaquette
// IV + tag + chiffré dans une seule chaîne base64 avec la clé MASTER_KEY —
// même mécanisme que pour les identifiants SSH et les canaux de notification,
// plutôt qu'un second schéma de chiffrement pour la même garantie.
model Mailbox {
  id           String   @id @default(cuid())
  email        String   @unique
  provider     String   @default("other")
  role         String   @default("both")   // both | send | receive
  imapHost     String?
  imapPort     Int?
  imapSecurity String?                     // ssl | starttls | none
  smtpHost     String?
  smtpPort     Int?
  smtpSecurity String?
  passwordEnc  String?
  active       Boolean  @default(true)
  lastTestAt   DateTime?
  lastTestOk   Boolean?
  lastTestInfo String?
  createdAt    DateTime @default(now())
}

/// Un flux sortant observé sur la passerelle.
///
/// Une ligne par quadruplet source/destination/port/protocole : un hôte bavard
/// ne fait pas gonfler la table indéfiniment, et on garde la première et la
/// dernière apparition, ce qui suffit à raconter l'historique.
model TrafficFlow {
  id         String   @id @default(cuid())
  srcIp      String
  dstIp      String
  port       Int      @default(0)
  proto      String   @default("tcp")

  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  /// Cumul depuis la première observation. Double : un Int déborderait à 2 Go.
  bytes      Float    @default(0)
  packets    Float    @default(0)
  /// Nombre de relevés où ce flux est apparu.
  hits       Int      @default(1)

  /// Ce que le DNS inverse et le registre ont rendu, tel quel.
  host       String?
  domain     String?
  operator   String?
  logo       String?
  /// Pays d'enregistrement du préfixe, pas une géolocalisation.
  country    String?

  /// « sortant » : une machine du parc est allée vers l'extérieur.
  /// « entrant » : l'extérieur est venu jusqu'à une machine du parc.
  direction  String   @default("sortant")
  /// Signalé par une règle explicite, jamais par une intuition. La raison est
  /// écrite juste en dessous : sans elle, un point rouge n'apprend rien.
  suspect    Boolean  @default(false)
  raison     String?

  @@unique([srcIp, dstIp, port, proto])
  @@index([lastSeen])
  @@index([dstIp])
}

/// Une clé d'accès (WebAuthn) inscrite par un utilisateur.
///
/// Déclarée ici et pas seulement créée en SQL : le conteneur lance
/// « prisma db push » au démarrage, et db push traite toute table absente du
/// schéma comme une dérive à supprimer. Table vide, il la supprime en
/// silence ; table pleine, il refuse et sort en erreur — c'est ce qui a mis
/// le backend en boucle de redémarrage. Toute table ajoutée doit donc figurer
/// ici, sans exception.
///
/// Aucune relation déclarée vers User : la table existe déjà en base sans
/// clé étrangère, et en ajouter une ferait diverger le schéma de la base.
model Passkey {
  id           String    @id
  userId       String
  /// Identifiant de la clé rendu par l'authentificateur, en base64url.
  credentialId String    @unique
  /// Clé publique, en base64url. Aucun secret : la partie privée ne quitte
  /// jamais l'appareil.
  publicKey    String
  /// Compteur anti-rejeu. BigInt : certains authentificateurs comptent large.
  counter      BigInt    @default(0)
  /// « usb », « internal », « hybrid »… tels que le navigateur les rapporte.
  transports   String?
  /// Nom donné par l'utilisateur, pour reconnaître la clé dans la liste.
  label        String?
  createdAt    DateTime  @default(now())
  lastUsed     DateTime?

  @@index([userId])
}

/// Réglages de sécurité propres à un compte.
model UserSecurity {
  userId         String  @id
  /// Un administrateur peut exiger un second facteur ; il ne peut pas en
  /// poser un à la place de l'intéressé.
  mfaRequired    Boolean @default(false)
  /// Discussion Telegram à laquelle envoyer le code, si ce facteur est choisi.
  telegramChatId String?
}
