{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "noImplicitAny": false
  },
  "include": ["src/**/*"],
  // Les tests ne partent pas dans l'image : ils importent vitest, qui n'a rien
  // à faire dans un conteneur de production. Sans cette exclusion, la
  // construction de l'image échoue sur « Cannot find module 'vitest' ».
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
