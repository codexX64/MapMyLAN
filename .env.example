# ─────────────────────────────────────────────────────────────────────
# MapMyLAN — startup configuration
#
# Only what must exist before the first launch appears here.
# Everything else is configured from the interface.
#
# No value is provided: generate your own. Copying an example secret
# would be the same as having none.
# ─────────────────────────────────────────────────────────────────────

# ── Secrets ──────────────────────────────────────────────────────────
#   openssl rand -base64 24
POSTGRES_PASSWORD=

#   openssl rand -base64 48   — signs the session tokens
JWT_SECRET=

#   openssl rand -base64 32   — encrypts the device credentials
#   Losing it makes the stored credentials unrecoverable.
MASTER_KEY=

#   Optional. Added to the password hash, kept outside the database:
#   a stolen database without it cannot be cracked offline.
PASSWORD_PEPPER=

# ── Network ──────────────────────────────────────────────────────────
#   Scan interface. List yours:
#     ip -o link show | awk -F': ' '{print $2}'
SCAN_INTERFACE=

#   Initial range. Others can be added later from the interface.
SCAN_SUBNET=192.0.2.0/24

#   Interval between two scans, in seconds.
SCAN_INTERVAL=300

# ── Account recovery ─────────────────────────────────────────────────
#   Leave EMPTY in normal operation.
#
#   If filled in, they overwrite the account password on EVERY
#   container startup — so any change made from the interface is
#   reverted on the next restart.
#
#   Only fill them in to regain access after a forgotten password, then
#   clear them again immediately.
DEFAULT_ADMIN_USER=
DEFAULT_ADMIN_PASSWORD=
