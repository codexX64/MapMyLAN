# MapMyLAN 2.0 — réglages (docker compose : copier en .env).
# Toute valeur invalide arrête le démarrage avec la liste des erreurs.
# Chaque secret peut venir d'un fichier : NOM_FILE=/chemin (secrets Docker).

# Écoute. En réseau hôte, préférer l'adresse d'un relais local plutôt que
# toutes les interfaces.
PORT=8090
HOTE=127.0.0.1

# Balayage : la plage de départ (d'autres s'ajoutent dans Réglages) et
# l'intervalle en secondes (0 : seulement les balayages lancés à la main).
SCAN_SUBNET=198.51.100.0/24
SCAN_INTERVAL=900
SCAN_INTERFACE=eth0

# Comptes (socle commun). La clé maîtresse vient de secrets/socle_cle
# (docker-compose.yml) : openssl rand -base64 32 > secrets/socle_cle
SOCLE_HTTP=0
# Jeton du premier compte : vide, MapMyLAN en tire un et l'écrit dans ses journaux.
SOCLE_JETON_INSTALLATION=
# Poivre des mots de passe (32 caractères aléatoires au moins). Reprise d'une
# 1.4.1 : la valeur de son PASSWORD_PEPPER, ou SOCLE_POIVRE_ANCIEN=aucun
# si elle n'en avait pas.
SOCLE_POIVRE=
SOCLE_POIVRE_ANCIEN=
# Relais inverses de confiance (CIDR, séparés par des virgules).
SOCLE_PROXYS=
SOCLE_ORIGINES=
SOCLE_URL_PUBLIQUE=
# Alertes de sécurité des comptes par courriel (facultatif).
SOCLE_SMTP_HOTE=
SOCLE_SMTP_PORT=
SOCLE_SMTP_SECURITE=tls
SOCLE_SMTP_UTILISATEUR=
SOCLE_SMTP_MOTDEPASSE=
SOCLE_SMTP_DE=

# Jeton d'intégration semé au démarrage (« hub_ » ou « mml_ » + 24 caractères
# aléatoires au moins), rôle membre. Facultatif.
INTEGRATION_TOKEN_SEED=

# Assistant (facultatif) : Ollama pour répondre, VOX pour la voix, SYNAPSE
# pour la mémoire partagée. Plafonds d'appels au modèle.
IA_URL=
IA_MODELE=
VOX_URL=
VOX_JETON=
SYNAPSE_URL=
SYNAPSE_JETON=
MAPMYLAN_IA_JOUR=200
MAPMYLAN_IA_JOUR_TOTAL=1000
MAPMYLAN_IA_MINUTE=10
MAPMYLAN_VOIX_JOUR=400
MAPMYLAN_VOIX_JOUR_TOTAL=2000

# Relais d'envoi « Poste » (facultatif, https).
POSTE_URL=
POSTE_FROM=
POSTE_SEND_KEY=

# Adresse de MapMyLAN pour un humain (liens des tickets, de SYNAPSE).
SERVICE_UI=

# Reprise d'une 1.4.1 seulement : son MASTER_KEY, pour rouvrir les secrets.
MAPMYLAN_V1_MASTER_KEY=
