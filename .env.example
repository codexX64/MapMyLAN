# ─────────────────────────────────────────────────────────────────────
# MapMyLAN — configuration de démarrage
#
# Seul ce qui doit exister avant le premier lancement figure ici.
# Tout le reste se règle depuis l'interface.
#
# Aucune valeur n'est fournie : générez la vôtre. Copier un secret
# d'exemple reviendrait à n'en avoir aucun.
# ─────────────────────────────────────────────────────────────────────

# ── Secrets ──────────────────────────────────────────────────────────
#   openssl rand -base64 24
POSTGRES_PASSWORD=

#   openssl rand -base64 48   — signature des jetons de session
JWT_SECRET=

#   openssl rand -base64 32   — chiffre les identifiants d'équipement
#   La perdre rend les identifiants enregistrés irrécupérables.
MASTER_KEY=

#   Facultatif. Ajouté au hachage des mots de passe, conservé hors base :
#   une base volée sans lui ne se casse pas hors ligne.
PASSWORD_PEPPER=

# ── Réseau ───────────────────────────────────────────────────────────
#   Interface du balayage. Lister les vôtres :
#     ip -o link show | awk -F': ' '{print $2}'
SCAN_INTERFACE=

#   Plage initiale. D'autres s'ajoutent ensuite depuis l'interface.
SCAN_SUBNET=192.0.2.0/24

#   Intervalle entre deux balayages, en secondes.
SCAN_INTERVAL=300

# ── Reprise en main ──────────────────────────────────────────────────
#   À laisser VIDES en fonctionnement normal.
#
#   Renseignés, ils réécrivent le mot de passe du compte à CHAQUE
#   démarrage du conteneur — donc tout changement fait depuis
#   l'interface est annulé au redémarrage suivant.
#
#   Ne les remplir que pour reprendre la main après un oubli, puis les
#   revider aussitôt.
DEFAULT_ADMIN_USER=
DEFAULT_ADMIN_PASSWORD=

# ── Exposition de l'API ──────────────────────────────────────────────
#   Le backend tourne en réseau hôte : par défaut il écoute sur TOUTES
#   les interfaces, donc sur le LAN, quelle que soit la posture du
#   pare-feu.
#
#   Ne pas poser 127.0.0.1 : le conteneur frontend joint l'API par la
#   passerelle du pont Docker, pas par la boucle locale de l'hôte.
#   L'adresse qui referme l'API sans couper l'interface est celle du
#   pont, à relever chez vous :
#     ip -4 addr show docker0 | awk '/inet /{print $2}' | cut -d/ -f1
#
#   Vérifiez que l'interface répond ENCORE après redémarrage. Si elle
#   ne répond plus, retirez la ligne : rien d'autre n'a changé.
BIND_ADDRESS=

# ── Courrier sortant (facultatif) ────────────────────────────────────
#   Relais HTTP d'envoi. Laissé vide, l'envoi de courrier est
#   simplement inactif ; les autres canaux d'alerte partent quand même.
POSTE_URL=
POSTE_FROM=
POSTE_ALIAS=
POSTE_SEND_KEY=

# ── Regroupement des interfaces (facultatif) ─────────────────────────
#   Deux premiers octets du plan d'adressage, quand le numéro d'appareil
#   est porté par le dernier octet et la catégorie par l'avant-dernier.
#   Vide = aucun regroupement proposé. Voir services/grouping.ts.
GROUPING_PREFIX=
